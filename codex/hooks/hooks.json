{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/tab-tag.mjs\"", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/tab-tag.mjs\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/tab-tag.mjs\"", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/tab-tag.mjs\"", "timeout": 3 }] }
    ]
  }
}
